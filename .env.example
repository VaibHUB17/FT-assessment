# ==============================================================================
# FreightWatch - Environment Configuration Template
# ==============================================================================

# 1. Groq API Key (for LLM inference, e.g. openai/gpt-oss-120b)
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key (for dense vector embeddings, e.g. gemini-embedding-001)
# Get an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
